{
  "name": "desk-box",
  "version": "0.4.1",
  "private": true,
  "description": "桌面收纳盒 —— 悬浮抽屉，把文件、链接、片段收进手边",
  "author": "tomcato",
  "repository": {
    "type": "git",
    "url": "https://github.com/FightZhanAng/desk-box.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "gen:icons": "node scripts/gen-icons.mjs",
    "postinstall": "node scripts/ensure-electron.mjs",
    "dev": "node scripts/electron-run.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/electron-run.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && node scripts/dist.mjs --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "pinyin-pro": "^3.29.5"
  }
}
